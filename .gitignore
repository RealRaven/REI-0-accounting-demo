# ========================
# Project specific
# ========================

# --- Screenshots & recordings (agent output) ---
screenshots/
recordings/
*.mp4
*.webm
# keep docs/ and app/web/static/ images
!docs/**/*.png
!docs/**/*.jpg
!app/web/static/**/*.png
!app/web/static/**/*.jpg

# --- Local model weights / caches ---
models/
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.onnx
.cache/
huggingface/
~/.cache/huggingface/

# --- vLLM / Torch / experiment logs ---
