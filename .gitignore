# --- Secrets & local configs ---
.env.local
.env.*.local
.env.test
.env.ci
config/local.yaml
config/secrets.yaml
*.local.yaml

# --- Demo / client data ---
# NEVER commit real client data.
data/clients/**
data/inbox/**
data/processed/**
!data/inbox/.gitkeep
!data/processed/.gitkeep

# Law PDFs are big and licensed — keep them local.
data/law/**
!data/law/.gitkeep

# Fixtures ARE committed (they're synthetic).
!data/fixtures/**
!data/fixtures/**/*.pdf
!data/fixtures/**/*.csv
!data/fixtures/**/*.json

# Tax tips ARE committed (curated knowledge).
!data/tax_tips/**
!data/tax_tips/**/*.yaml

# --- Local service data (if run outside docker) ---
qdrant_storage/
qdrant_data/
postgres_data/
pg_data/
redis_data/
celerybeat-schedule
celerybeat-schedule.*
*.sqlite
*.sqlite3
*.db

# --- PyAutoGUI / automation temp ---
